# IBM Event Streams (Apache Kafka) 接続情報
# このファイルをコピーして .env を作成してください。
# .env は .gitignore に追加されており Git にはコミットされません。

# ---- 必須設定 --------------------------------------------------------

# IBM Event Streams の Bootstrap Servers
# IBM Cloud コンソール → Event Streams → Service credentials → kafka_brokers_sasl
KAFKA_BOOTSTRAP_SERVERS=broker-0.example.cloud.ibm.com:9093

# IBM Event Streams の API キー
# Service credentials の api_key フィールド
KAFKA_USERNAME=token
KAFKA_PASSWORD=your-ibm-event-streams-api-key-here

# ---- 通常は変更不要 --------------------------------------------------

KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

# ---- 車両識別子 -------------------------------------------------------

VEHICLE_ID=freenove-car-01
